{
  "name": "react-example",
  "private": true,
  "version": "1.21.0",
  "type": "commonjs",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/assemble-catalog-manuals.cjs",
    "dev": "tsx server.ts",
    "build": "node scripts/assemble-catalog-manuals.cjs && npm run generate:all && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron release server.js",
    "generate:all": "npx prisma generate --schema=prisma/schema.prisma && npx prisma generate --schema=prisma/schema.postgresql.prisma && npx prisma generate --schema=prisma/schema.mariadb.prisma",
    "lint": "tsc --noEmit",
    "check": "tsx scripts/run-checks.ts",
    "build:electron": "npm run generate:all && esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --external:@prisma/client-sqlite --external:@prisma/client-pg --external:@prisma/client-mysql --external:@prisma/adapter-better-sqlite3 --external:@prisma/adapter-pg --external:@prisma/adapter-mariadb --external:mariadb --external:better-sqlite3 --external:pg --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.js",
    "prepare:win-native": "node scripts/prepare-win-native.cjs",
    "restore:linux-native": "node scripts/prepare-win-native.cjs --restore",
    "dist": "npm run build && npm run build:electron && npm run prepare:win-native && electron-builder --win portable -c.npmRebuild=false",
    "check:verification": "node --import tsx scripts/check-verification.ts",
    "check:coverage": "node --import tsx scripts/verification-inventory.ts",
    "check:programs": "node --import tsx scripts/verify-programs.ts",
    "build:studio": "node studio/build.cjs developer",
    "build:studio-owner": "node studio/build.cjs owner",
    "check:studio-bundle": "node --import tsx scripts/check-studio-bundle.ts",
    "test:studio-owner": "node studio/owner/scripts/test.cjs && node studio/shared/test-database-runtime.cjs && node studio/owner/scripts/test-diagnostics.cjs && node studio/owner/scripts/test-network.cjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-mysql": "file:./prisma-clients/client-mysql",
    "@prisma/client-pg": "file:./prisma-clients/client-pg",
    "@prisma/client-sqlite": "file:./prisma-clients/client-sqlite",
    "@tanstack/react-virtual": "^3.13.25",
    "7zip-bin-full": "26.3.1",
    "ajv": "^8.20.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "esbuild-wasm": "0.25.12",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "fast-xml-parser": "5.10.1",
    "imapflow": "^1.7.1",
    "jszip": "3.10.1",
    "lucide-react": "^0.546.0",
    "mailparser": "^3.9.15",
    "mammoth": "^1.11.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.15.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "ws": "8.21.0",
    "xlsx": "file:vendor/xlsx/xlsx-0.20.3.tgz",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@prisma/config": "^7.8.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.21",
    "electron": "41.7.2",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.25.0",
    "pdfjs-dist": "^6.1.200",
    "playwright-core": "^1.63.0",
    "prisma": "^7.8.0",
    "pyodide": "0.29.5",
    "tailwindcss": "^4.1.14",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "com.flux.app",
    "productName": "Flux",
    "asar": true,
    "asarUnpack": [
      "node_modules/@prisma/client-sqlite/**",
      "node_modules/@prisma/client-pg/**",
      "node_modules/@prisma/client-mysql/**",
      "node_modules/better-sqlite3/**"
    ],
    "portable": {
      "splashImage": null
    },
    "extraResources": [
      {
        "from": "prisma",
        "to": "prisma",
        "filter": [
          "**/*.prisma",
          "migrations/**/migration.sql",
          "migrations/migration_lock.toml"
        ]
      },
      {
        "from": "genoffice-server",
        "to": "genoffice-server"
      },
      {
        "from": "node_modules/7zip-bin-full/win/x64",
        "to": "archive",
        "filter": [
          "7z.exe",
          "7z.dll",
          "License.txt"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    }
  },
  "overrides": {
    "mariadb": "3.4.7",
    "engine.io": "6.6.10",
    "socket.io-parser": "4.2.7",
    "ws": "8.21.0"
  }
}
