// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../prisma-clients/client-pg"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String        @id @default(uuid())
  symbol           String        @unique // Табельный номер сотрудника, используемый как логин
  password         String        @default("password") // Пароль доступа
  name             String        // ФИО сотрудника
  lastName         String        @default("") // Фамилия — храним по частям, в именительном падеже
  firstName        String        @default("") // Имя
  middleName       String        @default("") // Отчество
  gender           String        @default("") // "M" | "F" — нужен для склонения и поздравления
  birthDate        DateTime?     // День рождения: поздравление на главном экране
  role             String        @default("ENGINEER_VENT") // "ADMIN", "MANAGER", "ENGINEER_VENT", "ENGINEER_AUTO"
  isActive         Boolean       @default(true) // Профиль включен администратором
  validUntil       DateTime?     // Срок действия профиля; null = бессрочно
  permissions      String?       // JSON персональных прав: {"project.create":{"enabled":true,"until":null}}
  signatureImage   String?
  signatureHeightMm Int          @default(8)
  hideOnline        Boolean      @default(false)
  lastLoginAt       DateTime?
  createdAt        DateTime      @default(now())
  createdFiles     FileNode[]    @relation("FileCreator")
  updatedFiles     FileNode[]    @relation("FileUpdater")
  pdfMarkups       PdfMarkup[]   @relation("MarkupAuthor")
  sentMessages     ChatMessage[] @relation("SentMessages")
  receivedMessages ChatMessage[] @relation("ReceivedMessages")
  chatGroups       ChatGroup[]   @relation("GroupMembers")
}

model Project {
  id           String        @id @default(uuid())
  name         String
  code         String        @default("")
  customer     String        @default("")
  contractor   String        @default("")
  description  String        @default("")
  info         String        @default("")
  status       String        @default("ACTIVE")
  /// Служебный проект: общий диск. В списке проектов не показывается
  system       Boolean       @default(false)
  createdAt    DateTime      @default(now())
  
  folders          Folder[]
  tags             Tag[]
  dictionaries     Dictionary[]
  tagTemplate      TagTemplate?
  equipmentSystems EquipmentSystem[]
  chatMessages     ChatMessage[]     @relation("LinkedProject")
  chatGroups       ChatGroup[]       @relation("ProjectGroups")
  constructorDocs  ConstructorDoc[]
}

// Документ Конструктора: книга-таблица, собираемая из данных проекта
// (см. docs/constructor-design-v0.25*.md). workbook — JSON-снапшот движка,
// bindings — привязки умных блоков (наша бизнес-логика, отдельно от движка).
model ConstructorDoc {
  id          String    @id @default(uuid())
  projectId   String
  name        String    @default("Без названия")
  kind        String    @default("DOC")    // "DOC" | "TEMPLATE"
  scope       String    @default("SHARED") // "SHARED" | "PERSONAL"
  ownerId     String?   // владелец личного документа (= createdById)
  named       Boolean   @default(false)    // имя дано человеком (гасит диалог при закрытии)
  description String    @default("")
  workbook    String    @default("")       // JSON-снапшот книги
  bindings    String    @default("[]")     // JSON: умные блоки
  settings    String    @default("{}")     // JSON: печать/ориентация и т.п.
  createdById String?
  updatedById String?
  deletedAt   DateTime? // корзина (мягкое удаление)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions    ConstructorDocVersion[]
  @@index([projectId, kind])
}

// Версия документа Конструктора: автоснимок перед обновлением данных,
// перед восстановлением и ручные сохранения. Храним последние 20 на документ.
model ConstructorDocVersion {
  id        String   @id @default(uuid())
  docId     String
  version   Int      // порядковый номер в документе
  workbook  String   @default("")
  bindings  String   @default("[]")
  comment   String   @default("") // «перед обновлением данных», «ручное сохранение»…
  authorId  String?
  createdAt DateTime @default(now())

  doc       ConstructorDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  @@index([docId, version])
}


// ── ВДР (Vendor Document Register): реестр документации поставщика ──
// Дизайн: docs/vdr-docflow-design.md §1. Реестр первичен: строка живёт и без
// документа; документ Конструктора привязывается через docId.
model DocRegister {
  id          String   @id @default(uuid())
  projectId   String
  name        String   @default("ВДР")
  vendor      String   @default("")
  contractor  String   @default("")
  owner       String   @default("")
  poNumber    String   @default("")
  standardId  String?  // применённый стандарт документооборота (DocStandard)
  ownerProjectNo      String @default("")
  contractorProjectNo String @default("")
  materialRequisition String @default("")
  equipmentTitle      String @default("")
  contractorDocNo     String @default("") // номер самого ВДР у трёх сторон
  ownerDocNo          String @default("")
  vendorDocNo         String @default("")
  revision            String @default("A")  // текущая ревизия самого ВДР
  revisions           String @default("[]") // история ревизий ВДР (JSON)
  preparedBy          String @default("")
  checkedBy           String @default("")
  approvedBy          String @default("")
  /// Кто именно подписывает: по ним берутся подписи на титул документа (§42).
  /// Имя рядом остаётся: в импортированных реестрах человек указан строкой,
  /// и терять её нельзя — сотрудника с таким именем может не быть в программе
  preparedById        String?
  checkedById         String?
  approvedById        String?
  columnsConfig       String @default("[]") // JSON: колонки реестра (импортированные + свои)
  managerId   String?  // ответственный менеджер (получает «документ готов»)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       DocRegisterItem[]
  @@index([projectId])
}

model DocRegisterItem {
  id             String    @id @default(uuid())
  registerId     String
  projectId      String
  contractorNo   String    @default("")
  ownerNo        String    @default("")
  vendorNo       String    @default("")
  titleEn        String    @default("")
  titleRu        String    @default("")
  vdrCode        String    @default("") // тип: C01, E02, K32…
  revision       String    @default("A") // буквы = черновые, цифры = утверждённые
  issueDate      DateTime?
  reasonForIssue String    @default("") // IFR | IFI | CEF
  language       String    @default("")
  equipmentTags  String    @default("[]") // JSON: идентификаторы тегов
  status         String    @default("DRAFT") // DRAFT | READY | REMARKS | ACCEPTED
  docId          String?   // ConstructorDoc сформированного документа
  fileNodeId     String?   // файл замечаний в Проводнике
  assigneeId     String?   // инженер-исполнитель (получает «замечания»)
  remarks        String    @default("")
  reviewCode     String    @default("") // код рассмотрения заказчика (A/B/C/D/Q…)
  dueDate        DateTime? // срок следующей ревизии (по коду и дедлайнам стандарта)
  extra          String    @default("{}") // значения нестандартных колонок (columnsConfig)
  meta           String    @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  register       DocRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  @@index([registerId])
  @@index([projectId, status])
}


// ── Стандарт документооборота — ГЛОБАЛЬНЫЙ шаблон программы ──
// Профиль заказчика/проекта: коды рассмотрения с дедлайнами, причины выпуска,
// правила ревизий (буквенные/цифровые, V/S), маски нумерации документов и
// имён файлов, каталог типов документов (VDR-коды). Хранится один раз,
// применяется к реестрам любых проектов (DocRegister.standardId).
model DocStandard {
  id        String   @id @default(uuid())
  name      String   @default("Стандарт")
  config    String   @default("{}") // JSON: reviewCodes, reasons, revisionRules, masks, vdrTypes, columns
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// История ревизий строки ВДР (документа): лист «Учёт ревизий» документа
// и лист Accounting for revisions при экспорте собираются отсюда.
model DocRegisterItemRevision {
  id          String   @id @default(uuid())
  itemId      String
  revision    String
  date        DateTime @default(now())
  reason      String   @default("") // IFR | IFI | IFU | CEF | VOID | SUPERSEDED
  place       String   @default("") // место изменения
  description String   @default("") // описание изменения
  authorId    String?
  createdAt   DateTime @default(now())

  @@index([itemId])
}


model Dictionary {
  id        String   @id @default(uuid())
  projectId String
  name      String
  items     DictionaryItem[]
  
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DictionaryItem {
  id           String           @id @default(uuid())
  dictionaryId String
  code         String
  nameRu       String
  parentId     String?
  parent       DictionaryItem?  @relation("HierarchicalItems", fields: [parentId], references: [id], onDelete: Cascade)
  children     DictionaryItem[] @relation("HierarchicalItems")

  dictionary   Dictionary @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)
}

model TagTemplate {
  id         String   @id @default(uuid())
  projectId  String   @unique
  schemaJson String

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Folder {
  id          String   @id @default(uuid())
  name        String
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scope       String   @default("SHARED") // "SHARED" — общий раздел, "PERSONAL" — личный раздел пользователя
  ownerId     String?  // Владелец личной папки (User.id); null для общих
  system      Boolean  @default(false) // Системная папка: нельзя удалить/переименовать

  parentId    String?
  parent      Folder?  @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[] @relation("FolderToFolder")
  
  files       FileNode[]
  updatedAt   DateTime @default(now()) @updatedAt
  deletedAt   DateTime? // корзина: папка скрыта, но восстановима
  deletedById String?
}

model FileNode {
  id          String   @id @default(uuid())
  name        String
  filePath    String
  /// Откуда файл принесли из Windows — по этому пути выгрузка предложит ту же папку
  origin      String   @default("")
  size        Int      @default(0)
  type        String   @default("FILE")
  department  String?
  statusCode  String   @default("D")
  revision    String   @default("1")
  scope       String   @default("SHARED") // "SHARED" | "PERSONAL" (для файлов в корне раздела)
  ownerId     String?  // Владелец личного файла (User.id); null для общих
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("FileCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?    @relation("FileUpdater", fields: [updatedById], references: [id])
  updatedAt   DateTime @default(now()) @updatedAt
  content     String?
  refId       String?  // Ссылка на сущность программы (type="CONSTRUCTOR" → ConstructorDoc.id)

  folderId    String?
  folder      Folder?   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  
  mainTags        Tag[]    @relation("FileMainTags")
  additionalTags  Tag[]    @relation("FileAdditionalTags")
  deletedAt   DateTime? // корзина: файл скрыт, но восстановим
  deletedById String?

  pdfMarkups  PdfMarkup[]
  chunks         FileChunk[]
}

model Equipment {
  id          String   @id @default(uuid())
  type        String   // "VALVE", "FAN", "AHU", "CONTROL_PANEL"
  description String?
  tags        Tag[]
}

model Tag {
  id           String      @id @default(uuid())
  identifier   String      // e.g. AHU-2
  brand        String?     // Марка
  department   String?
  wbs          String?
  fluid        String?
  projectId    String
  equipmentId  String?
  metadata     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime?   @updatedAt // для индикатора «данные изменились» в Конструкторе
  
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  equipment    Equipment?  @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  mainFiles        FileNode[]  @relation("FileMainTags")
  additionalFiles  FileNode[]  @relation("FileAdditionalTags")
  componentElements ComponentElement[]
}

model EquipmentSystem {
  id            String          @id @default(uuid())
  name          String          // e.g. "у1"
  projectId     String
  category      String          @default("AHU") // Возможные значения: "AHU", "FAN", "VALVE", "CURTAIN"
  fileName      String?         // Added to keep different imported files separate
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  monoblocks    Monoblock[]
  createdAt     DateTime        @default(now())
}

model Monoblock {
  id                String             @id @default(uuid())
  name              String             // e.g. "мн1"
  systemId          String
  system            EquipmentSystem    @relation(fields: [systemId], references: [id], onDelete: Cascade)
  components        ComponentElement[]
  createdAt         DateTime           @default(now())
}

model ComponentElement {
  id            String             @id @default(uuid())
  name          String             // e.g. "бл2.1"
  itemCode      String             // Stable unique business code (e.g., "бл2.1")
  monoblockId   String
  monoblock     Monoblock          @relation(fields: [monoblockId], references: [id], onDelete: Cascade)
  specs         String?            // JSON: { groups: [{title, params:[{key,value,unit}]}] }
  equipType     String             @default("ПРОЧЕЕ") // КЛАПАН/ФИЛЬТР/НАГРЕВАТЕЛЬ/...
  overrides     String?            // JSON: ручные переопределения значений { "группа|ключ": "значение" }
  paramConflicts String?           // JSON: конфликтные параметры последней ревизии [{group,key,oldValue,newValue}]
  tags          Tag[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now())
  status        String             @default("OK") // e.g., "OK", "CONFLICT"
  hasConflict   Boolean            @default(false)
  conflictType  String?            // "ORPHANED_TAG", "TYPE_MISMATCH"
  conflictLog   String?
  version       Int                @default(1)
  history       EquipmentHistory[]
  chatMessages  ChatMessage[]      @relation("LinkedElement")
}

model EquipmentHistory {
  id          String           @id @default(uuid())
  elementId   String
  element     ComponentElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  version     Int
  changedAt   DateTime         @default(now())
  oldSpecs    String?
  newSpecs    String?
  changeType  String           // "UPDATE", "DELETE", "CREATE"
  // Партия импорта: по ней отменяется весь ввоз расчёта целиком, а не
  // поэлементно. Пусто у записей, сделанных вручную и до этой правки.
  batchId     String?
}

model UserNote {
  id          String   @id @default(uuid())
  title       String   @default("Новая заметка")
  ownerId     String?  // Владелец заметки; null — заметка из версий до личного блокнота
  content     String   // Хранение HTML-строки или JSON-дерева Rich-text редактора
  color       String   @default("bg-amber-50 dark:bg-amber-950/20 border-amber-200") // Набор в разделе «Блокнот»: amber, rose, emerald, slate
  equipmentId String?  // Опциональная привязка к тегу/оборудованию
  groupName   String?  // Пользовательская группа заметок в блокноте
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemChangeLog {
  id          String   @id @default(uuid())
  userName    String   // Кто изменил (например, "Главный Администратор")
  userSymbol  String   // Символ/ID (например, "RaupovKhKh")
  description String   // Что изменено ("Обновлены спецификации вентилятора по тегу AHU-2")
  targetRoute String   // Маршрут/параметры для сквозного перехода (например, "/equipment?tag=AHU-2")
  createdAt   DateTime @default(now())
}

model ChatGroup {
  id        String        @id @default(uuid())
  name      String
  type      String        @default("PROJECT") // "DIRECT" | "PROJECT" | "CUSTOM" | "CHANNEL"
  description String      @default("")
  color     String        @default("indigo")
  ownerId   String?       // владелец группы/канала
  projectId String?
  project   Project?      @relation("ProjectGroups", fields: [projectId], references: [id], onDelete: Cascade)
  members   User[]        @relation("GroupMembers")
  messages  ChatMessage[] @relation("GroupMessages")
  createdAt DateTime      @default(now())
}

model ChatMessage {
  id              String            @id @default(uuid())
  content         String
  createdAt       DateTime          @default(now())
  senderId        String
  sender          User              @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId      String?
  receiver        User?             @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  chatGroupId     String?
  chatGroup       ChatGroup?        @relation("GroupMessages", fields: [chatGroupId], references: [id], onDelete: Cascade)
  linkedElementId String?
  linkedElement   ComponentElement? @relation("LinkedElement", fields: [linkedElementId], references: [id], onDelete: SetNull)
  linkedProjectId String?
  linkedProject   Project?          @relation("LinkedProject", fields: [linkedProjectId], references: [id], onDelete: SetNull)
  attachments     ChatAttachment[]
  replyToId       String?           // Ответ на сообщение (цитата)
  replyTo         ChatMessage?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         ChatMessage[]     @relation("MessageReplies")
  editedAt        DateTime?         // Когда сообщение было отредактировано
  reactions       String?           // JSON: { "👍": ["userId", ...], ... }
  pinned          Boolean           @default(false)
  forwardedFrom   String?           // имя исходного отправителя при пересылке
}

model ChatAttachment {
  id        String      @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName  String
  filePath  String
  fileSize  Int         @default(0)
}

model AppSetting {
  id        String   @id @default(uuid())
  key       String   // напр. equip_visibility, equip_conflict_mode, equip_categories
  userId    String?  // null = глобальная (админ) настройка; иначе персональная
  value     String   // JSON
  updatedAt DateTime @updatedAt @default(now())

  @@unique([key, userId])
}

model AppUpdate {
  id        String   @id @default(uuid())
  version   String   @unique
  changelog String
  fileUrl   String
  createdAt DateTime @default(now())
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  category    String   @default("СИСТЕМА")
  title       String
  body        String   @default("")
  targetRoute String   @default("")
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, isRead])
}


// Роль сотрудника. Раньше роли были зашиты в коде четырьмя строками; теперь
// их заводит администратор в настройках, и они видны везде, где показывается
// сотрудник. level = 1 — главный администратор: только он управляет ролями
// и выдаёт доступ. Встроенные роли (isSystem) нельзя удалить, чтобы
// программа не осталась без администратора.
model Role {
  id          String   @id @default(uuid())
  code        String   @unique // ADMIN, MANAGER, ENGINEER_VENT… и пользовательские
  name        String   // «Инженер ОВиК»
  description String   @default("")
  color       String   @default("slate") // цвет значка роли
  icon        String   @default("user")  // имя значка lucide
  level       Int      @default(50)      // 1 = главный администратор
  isSystem    Boolean  @default(false)
  permissions String   @default("{}")    // права по умолчанию при назначении роли
  sortOrder   Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


// С кем сотрудник поделился своей заметкой. Блокнот личный, но заметку
// можно открыть коллегам: на просмотр или на совместную правку.
model NoteShare {
  id        String   @id @default(uuid())
  noteId    String
  userId    String   // кому открыт доступ
  canEdit   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([noteId, userId])
  @@index([userId])
}


model DocFormula {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  kind        String
  config      String   @default("{}")
  sortOrder   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@index([projectId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Почта. Ящик подключается по IMAP/SMTP и принадлежит одному сотруднику:
// переписка личная, её не видит и администратор.
//
// Письма синхронизируются в базу заголовками — отправитель, тема, фрагмент,
// флаги. Тело и вложения тянутся при открытии: тысяча писем это несколько
// мегабайт, а не гигабайты, и список открывается мгновенно.
// ─────────────────────────────────────────────────────────────────────────────

model MailAccount {
  id           String    @id @default(uuid())
  // Кому принадлежит ящик. PERSONAL — личный, ownerId заполнен, настраивает
  // сам сотрудник и может завести несколько. SHARED — общая почта компании,
  // ownerId пуст, настраивается один раз и видна всем.
  scope        String    @default("PERSONAL")  // PERSONAL | SHARED
  ownerId      String    @default("")          // User.id для личного; пусто для общего
  label        String    @default("")          // Как назвать ящик в списке слева
  sortOrder    Int       @default(100)         // Порядок в списке ящиков
  email        String                          // Обратный адрес
  displayName  String    @default("")          // Имя в поле «От кого»
  imapHost     String
  imapPort     Int       @default(993)
  imapSecure   Boolean   @default(true)
  smtpHost     String
  smtpPort     Int       @default(465)
  smtpSecure   Boolean   @default(true)
  login        String                          // Обычно совпадает с email, но не всегда
  secret       String                    // Пароль под AES-256-GCM; наружу не отдаётся
  secretNonce  String    @default("")
  syncDays     Int       @default(90)          // На сколько дней вглубь тянуть при первом входе
  active       Boolean   @default(true)
  lastSyncAt   DateTime?
  lastError    String  @default("")      // Последняя ошибка связи — видна в разделе
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([ownerId])
  @@index([scope])
}

model MailFolder {
  id           String    @id @default(uuid())
  accountId    String
  path         String                          // Путь IMAP как есть: "INBOX", "[Gmail]/Drafts"
  name         String                          // Как показываем человеку
  kind         String    @default("CUSTOM")    // INBOX SENT DRAFTS TRASH SPAM ARCHIVE CUSTOM
  // Метка поколения папки. Сервер сменил её — все сохранённые uid указывают
  // на другие письма, и папку надо перечитать целиком.
  uidValidity  String    @default("")
  lastUid      Int       @default(0)
  unread       Int       @default(0)
  total        Int       @default(0)
  sortOrder    Int       @default(100)
  syncedAt     DateTime?

  @@unique([accountId, path])
  @@index([accountId])
}

model MailMessage {
  id           String    @id @default(uuid())
  accountId    String
  folderId     String
  uid          Int                             // Номер письма в папке
  messageId    String    @default("")          // Message-ID из заголовка
  inReplyTo    String    @default("")          // In-Reply-To
  refs         String  @default("")      // References, через пробел
  threadKey    String    @default("")          // Корень цепочки — считаем сами
  fromName     String  @default("")
  fromAddr     String    @default("")
  toAddrs      String  @default("")      // «Имя <адрес>» через запятую
  ccAddrs      String  @default("")
  subject      String  @default("")
  snippet      String  @default("")      // Первые ~200 знаков для списка
  sentAt       DateTime
  size         Int       @default(0)
  seen         Boolean   @default(false)
  flagged      Boolean   @default(false)
  answered     Boolean   @default(false)
  draft        Boolean   @default(false)
  hasFiles     Boolean   @default(false)
  // Тема, отправитель и фрагмент одной строкой в нижнем регистре.
  // LIKE в SQLite приводит к нижнему регистру только латиницу, поэтому
  // искать по-русски без заранее приведённого поля нельзя.
  searchText   String  @default("")
  bodyText     String?                   // Тянется при открытии
  bodyHtml     String?
  bodyAt       DateTime?

  @@unique([folderId, uid])
  @@index([accountId, threadKey])
  @@index([folderId, sentAt])
  @@index([accountId, seen])
}

model MailAttachment {
  id           String    @id @default(uuid())
  messageId    String                          // MailMessage.id
  partId       String    @default("")          // Часть письма в терминах IMAP
  fileName     String  @default("")
  filePath     String  @default("")      // Файл на диске, как вложения Чата
  size         Int       @default(0)
  mimeType     String    @default("")
  contentId    String    @default("")          // Для картинок внутри письма
  inline       Boolean   @default(false)

  @@index([messageId])
}

model MailDraft {
  id           String    @id @default(uuid())
  accountId    String
  ownerId      String
  toAddrs      String  @default("")
  ccAddrs      String  @default("")
  bccAddrs     String  @default("")
  subject      String  @default("")
  bodyHtml     String  @default("")
  inReplyToId  String    @default("")          // MailMessage.id, если это ответ
  mode         String    @default("NEW")       // NEW | REPLY | REPLY_ALL | FORWARD
  files        String  @default("[]")    // JSON: приложенные файлы
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([ownerId])
}

// ── Подписи ──────────────────────────────────────────────────────────────
// Подпись личная: сотрудник заводит её себе сам. Одна и та же подпись может
// стоять на всех ящиках (accountId пуст) или только на выбранном — с общей
// почты человек подписывается иначе, чем со своей.
model MailSignature {
  id           String    @id @default(uuid())
  ownerId      String                          // Чья подпись (User.id)
  accountId    String    @default("")          // Пусто — годится для всех ящиков
  name         String    @default("Подпись")   // Как называется в списке
  html         String    @default("")          // Разметка подписи
  isDefault    Boolean   @default(false)       // Подставлять в новое письмо
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([ownerId])
}

// Картинки подписи: логотип компании, скан подписи. Лежат на диске, как
// вложения; при отправке вставляются в письмо частями с Content-ID, иначе
// почтовые службы вырежут ссылку на наш сервер.
model MailSignatureImage {
  id           String    @id @default(uuid())
  ownerId      String
  fileName     String    @default("")
  filePath     String    @default("")
  mimeType     String    @default("")
  size         Int       @default(0)
  width        Int       @default(0)           // Ширина показа в письме, px
  createdAt    DateTime  @default(now())

  @@index([ownerId])
}

// ── Общий ящик ───────────────────────────────────────────────────────────
// Флаг \Seen в IMAP один на всех: стоит одному сотруднику открыть письмо, и
// у девяти остальных оно перестанет быть непрочитанным. Для общей почты это
// неверно — «я это видел» у каждого своё, поэтому храним отметку у себя.
model MailSeenLocal {
  id           String    @id @default(uuid())
  accountId    String
  userId       String
  // Message-ID письма, а не наш id: он переживает пересинхронизацию папки
  // и смену uidValidity, после которых наши строки создаются заново.
  msgKey       String
  seenAt       DateTime  @default(now())

  @@unique([accountId, userId, msgKey])
  @@index([accountId, userId])
}

// Состояние переписки в общем ящике: кто взял в работу и кто ответил.
// Ключ — цепочка, а не письмо: в работу берут разговор целиком.
model MailThreadState {
  id             String    @id @default(uuid())
  accountId      String
  threadKey      String
  status         String    @default("NEW")     // NEW | IN_PROGRESS | ANSWERED | CLOSED
  claimedById    String    @default("")
  claimedByName  String    @default("")
  claimedAt      DateTime?
  repliedById    String    @default("")
  repliedByName  String    @default("")
  repliedAt      DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([accountId, threadKey])
  @@index([accountId, status])
}

// Лента действий по переписке — чтобы девять остальных видели, что произошло.
model MailActivity {
  id           String    @id @default(uuid())
  accountId    String
  threadKey    String
  userId       String    @default("")
  userName     String    @default("")
  kind         String    @default("NOTE")      // CLAIMED RELEASED REPLIED FORWARDED STATUS NOTE
  note         String    @default("")
  createdAt    DateTime  @default(now())

  @@index([accountId, threadKey])
}


// ── Перевод: глоссарий, память, связь версий документа ──
// Дизайн: docs/translator-design.md. Переводит не программа, а прошлый труд
// инженера: подтверждённые пары копятся здесь и переживают любую ревизию.

// Термин глоссария. projectId пуст — термин общий для всех проектов.
model TermEntry {
  id        String   @id @default(uuid())
  projectId String?
  ru        String   @default("")
  en        String   @default("")
  zh        String   @default("")
  note      String   @default("") // «по требованию заказчика» и прочие пометки
  source    String   @default("hand") // hand | vdr | standard | pack | import
  locked    Boolean  @default(false) // менять нельзя: согласовано с заказчиком
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// Память переводов: подтверждённый перевод одного сегмента.
model TmUnit {
  id        String   @id @default(uuid())
  projectId String?
  fromLang  String   @default("ru")
  toLang    String   @default("en")
  srcKey    String   @default("") // нормализованный ключ поиска
  src       String   @default("")
  dst       String   @default("")
  origin    String   @default("hand") // hand | doc | vdr | mail | pack
  docId     String? // документ, из которого пришла пара
  authorId  String?
  usedCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromLang, toLang, srcKey])
  @@index([projectId])
}

// Английская версия документа и её связь с русским исходником.
model TransLink {
  id          String   @id @default(uuid())
  projectId   String
  sourceDocId String
  targetDocId String   @default("")
  mode        String   @default("file") // file | column | lines | sheet
  fingerprint String   @default("") // отпечаток русского текста на момент перевода
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([sourceDocId])
}

// ── Календарь ────────────────────────────────────────────────────────────────
// Событие: встреча, личное напоминание или заметка на времени.
//
// Сроков ВДР здесь нет и не будет: они собираются из реестра на лету
// (src/lib/calendar.ts, deadlineEvent). Запись срока в эту таблицу означала бы
// второй источник правды о сроке, и он разошёлся бы с реестром в первую же
// неделю — а разойдясь, солгал бы обеим сторонам.
model CalEvent {
  id          String     @id @default(uuid())
  projectId   String? // личное событие живёт без проекта
  kind        String     @default("meeting") // meeting | reminder | note
  title       String     @default("")
  description String     @default("")
  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean    @default(false)
  rrule       String     @default("") // повтор по RFC 5545, подмножество
  place       String     @default("")
  joinUrl     String     @default("") // ссылка на встречу: Телемост, МТС Линк, Teams
  createdBy   String     @default("")
  source      String     @default("hand") // hand | mail | assistant
  sourceId    String     @default("") // письмо, из которого родилось событие
  visibility  String     @default("project") // project | private
  remindMin   Int        @default(0) // за сколько минут напомнить; 0 — не напоминать
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  guests      CalGuest[]

  @@index([projectId, startsAt])
  @@index([createdBy])
}

// Участник встречи и его ответ.
model CalGuest {
  id      String   @id @default(uuid())
  eventId String
  userId  String
  state   String   @default("invited") // invited | yes | no | maybe
  event   CalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

// Кто работает над проектом.
//
// Единственное настоящее ограничение доступа в программе: нет записи — нет
// проекта. Он не в списке, не в переключателе, не в поиске; его файлы не
// отдаются, письма не показываются, теги не находятся. Всё остальное
// («тридцать галочек прав») убрано намеренно — см. docs/os-design.md §22.
model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  addedBy   String   @default("")
  addedAt   DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

/// Разговор с помощником: личная переписка одного человека.
///
/// Сообщения лежат одной строкой JSON, а не отдельной таблицей: реплика
/// помощника — не текст, а карточка с таблицей, кнопками и вложением, и
/// раскладывать её по колонкам значило бы описывать в базе разметку ответа.
/// Разговор читается и пишется целиком, поиск идёт по полю search.
model AssistantChat {
  id        String   @id @default(uuid())
  /// Чей разговор. Видит только он — администратор тоже не видит
  ownerId   String
  /// О каком проекте говорили; пусто — разговор вне проекта
  projectId String   @default("")
  title     String   @default("")
  /// Начало последнего ответа: вторая строка в списке разговоров
  preview   String   @default("")
  /// Реплики целиком: JSON-массив AssistantMessage
  messages  String   @default("[]") @db.Text
  /// Все реплики строчными буквами — по нему ищут «о чём я спрашивал»
  search    String   @default("") @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, projectId])
}

/// Кто сейчас в сети.
///
/// Живёт в базе, а не в памяти сервера, и это принципиально. В отделе у
/// каждого свой встроенный сервер, а база одна на всех: присутствие в памяти
/// означало бы, что каждый сидит в своей комнате один и все для него «не в
/// сети». Ровно так это и выглядело у заказчика.
model Presence {
  /// Кто. Одна строка на человека, сколько бы окон он ни открыл
  userId String   @id
  /// Когда его в последний раз видели: «в сети» — если недавно
  at     DateTime @default(now())

  @@index([at])
}

/// Файл обновления — кусками в ОБЩЕЙ БАЗЕ.
///
/// Единственное, что есть у всех сотрудников общего, — эта база. Сервера
/// приложения у них нет: программа каждого поднимает свой встроенный. Пока
/// запись о релизе лежала в общей базе, а сам exe — на диске того, кто его
/// опубликовал, все остальные видели «доступна новая версия» и получали
/// «файла этой версии нет». Теперь файл едет туда же, где и запись о нём.
///
/// Кусками, а не одним полем: 130 мегабайт одним запросом не проходят —
/// у MariaDB есть предел размера пакета, и он обычно меньше.
model AppUpdateChunk {
  id      String @id @default(uuid())
  version String
  /// Номер куска по порядку; собирается обратно по нему
  idx     Int
  data    Bytes

  @@unique([version, idx])
  @@index([version])
}

/// Журнал действий: кто, что, над чем и когда. Пишет сервер, а не окно —
/// запись, которую делает окно, обходится закрытием окна
model ActionLog {
  id        String   @id @default(uuid())
  userId    String   @default("")
  userName  String   @default("")
  what      String   @default("")
  target    String   @default("")
  route     String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

/// Пометки на чертежах ПДФ: облако, рамка, стрелка, записка, штамп, подпись.
///
/// Хранятся рядом с файлом, а не внутри него: присланный чертёж ценен тем, что
/// он не изменён. Координаты — доли страницы (0..1), а не точки: чертёж A1 и
/// его же скан в другом разрешении дают одно и то же место.
model PdfMarkup {
  id          String    @id @default(uuid())
  fileId      String
  file        FileNode  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  /// Ревизия чертежа на момент постановки пометки
  revision    String    @default("1")
  page        Int       @default(1)
  /// CLOUD | ARROW | RECT | NOTE | STAMP | PEN | SIGN
  kind        String    @default("CLOUD")
  x           Float     @default(0)
  y           Float     @default(0)
  w           Float     @default(0)
  h           Float     @default(0)
  color       String    @default("#be123c")
  strokeWidth Int       @default(2)
  text        String?
  /// OPEN | DONE | REJECTED — учтено ли замечание
  state       String    @default("OPEN")
  createdAt   DateTime  @default(now())
  createdById String?
  createdBy   User?     @relation("MarkupAuthor", fields: [createdById], references: [id])
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?

  @@index([fileId, revision])
}

/// Содержимое файла кусками. Строка `FileNode.content` держала весь файл
/// целиком, и предел выходил не из политики, а из размера пакета базы:
/// у MariaDB это 5 МБ при скромной настройке. Кусками едет и файл обновления
/// (AppUpdateChunk) — здесь та же схема, только для файлов Проводника.
model FileChunk {
  id     String @id @default(uuid())
  fileId String
  file   FileNode @relation(fields: [fileId], references: [id], onDelete: Cascade)
  /// Номер куска по порядку; собирается обратно по нему
  idx    Int
  data   Bytes

  @@unique([fileId, idx])
  @@index([fileId])
}

// ════════════════════════════════════════════════════════════════════════════
// Обращения сотрудников: «Замечания и предложения»
//
// До этого раздела сообщение о поломке уходило репликой в общий чат-канал: без
// номера, статуса, исполнителя и ответа автору. Здесь у обращения появляется
// жизнь — от отправки до проверки исправления.
//
// Три решения, которые видно прямо в схеме.
//
// Личность нигде не связана внешним ключом: сотрудника могут удалить, а его
// обращения и переписка по ним обязаны остаться. Поэтому автор — строка, а имя
// на момент отправки хранится снимком.
//
// Удалений нет. Отклонение, отзыв и объединение дублей — это состояния, а не
// стирание: разбор через полгода должен видеть, что было и почему.
//
// Вложения лежат кусками в общей базе, а не на диске. У каждого сотрудника свой
// встроенный сервер, и файл, оставшийся на его машине, для остальных не
// существует.
// ════════════════════════════════════════════════════════════════════════════

/// Само обращение.
model FeedbackReport {
  id                        String   @id @default(uuid())
  /// Короткий номер для человека: «ОБР-000123». Выдаётся счётчиком в
  /// транзакции, а не как MAX+1: два сервера иначе выдадут один и тот же
  number                    Int      @unique
  /// Автор — только строка: сотрудника могут удалить, обращение остаётся
  authorId                  String
  /// Имя на момент отправки: сотрудника переименуют, а карточку читать сегодня
  authorDisplayNameSnapshot String
  /// Ключ отправки. Тот же ключ — та же карточка: обрыв связи не плодит вторую
  clientRequestId           String
  /// Отпечаток отправленного тела: тот же ключ с другим текстом — это ошибка
  submitHash                String
  /// IDEA | BUG | PERFORMANCE | QUESTION
  type                      String   @default("BUG")
  title                     String
  description               String
  /// Шаги воспроизведения, JSON-массив строк
  reproductionJson          String   @default("[]")
  expected                  String   @default("")
  actual                    String   @default("")
  benefit                   String   @default("")
  /// ONCE | SOMETIMES | ALWAYS | UNKNOWN
  frequency                 String   @default("UNKNOWN")
  /// LOW «есть обход» | NORMAL «мешает» | HIGH «не могу продолжить»
  impact                    String   @default("NORMAL")
  /// Раздел программы, где случилось
  sectionKey                String   @default("")
  projectId                 String?
  /// Когда возникло — по словам автора, а не когда отправлено
  incidentAt                DateTime
  appVersion                String   @default("")
  /// NEW | TRIAGE | NEEDS_INFO | PLANNED | IN_PROGRESS | VERIFY | DONE | REJECTED | DUPLICATE | WITHDRAWN
  status                    String   @default("NEW")
  /// Куда вернуться после ответа автора: вопрос не должен ронять работу в начало
  resumeStatus              String?
  /// P0 | P1 | P2 | P3. Влияние описывает автор, очередь назначает обработчик
  priority                  String   @default("P2")
  assigneeId                String?
  resolution                String   @default("")
  resolvedVersion           String?
  duplicateOfId             String?
  /// Проверяется в той же транзакции, что изменение: два обработчика не должны
  /// молча перезаписать статус друг друга
  revision                  Int      @default(1)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @default(now()) @updatedAt
  closedAt                  DateTime?
  firstResponseAt           DateTime?
  /// Последнее событие, видимое автору, и последнее внутреннее — врозь:
  /// внутренняя заметка не должна помечать карточку новой для автора
  lastPublicAt              DateTime @default(now())
  lastInternalAt            DateTime?

  @@unique([authorId, clientRequestId])
  @@index([authorId, createdAt])
  @@index([status, priority, createdAt])
  @@index([assigneeId, status])
  @@index([sectionKey, appVersion])
  @@index([duplicateOfId])
}

/// Счётчик короткого номера. Одна строка на всю базу, инкремент атомарный.
model FeedbackCounter {
  key   String @id
  value Int    @default(0)
}

/// Предел частоты: сколько обращений и комментариев человек завёл за час.
/// Живёт в общей базе, а не в памяти: иначе три встроенных сервера обойдут
/// предел втроём.
model FeedbackRateWindow {
  id          String   @id @default(uuid())
  actorId     String
  /// report | comment
  kind        String
  /// Начало часового окна
  windowStart DateTime
  count       Int      @default(0)

  @@unique([actorId, kind, windowStart])
  @@index([windowStart])
}

/// Ответ автору или внутренняя заметка обработчиков.
model FeedbackComment {
  id              String   @id @default(uuid())
  reportId        String
  authorId        String
  clientRequestId String
  /// PUBLIC | INTERNAL. Внутреннее не доходит до автора ни одним путём
  visibility      String   @default("PUBLIC")
  text            String
  createdAt       DateTime @default(now())
  /// Убранный администратором текст: сам текст не сохраняется нигде
  redactedAt      DateTime?
  redactionReason String?

  @@unique([authorId, clientRequestId])
  @@index([reportId, createdAt])
}

/// Что происходило с карточкой. Событие на каждое изменение, по одному на
/// ревизию: история не имеет пропусков.
model FeedbackEvent {
  id         String   @id @default(uuid())
  reportId   String
  actorId    String?
  /// created | statusChanged | assigned | priorityChanged | commented |
  /// duplicateLinked | duplicateUnlinked | attachmentExpired | confirmed |
  /// reopened | redacted
  kind       String
  /// PUBLIC | INTERNAL
  visibility String   @default("PUBLIC")
  revision   Int
  dataJson   String   @default("{}")
  createdAt  DateTime @default(now())

  @@unique([reportId, revision])
  @@index([reportId, createdAt])
}

/// Загрузка: файл, который ещё едет или уже приехал, но не привязан к карточке.
model FeedbackUpload {
  id                   String   @id @default(uuid())
  ownerId              String
  clientRequestId      String
  draftId              String   @default("")
  /// IMAGE | FILE | DIAGNOSTICS
  kind                 String   @default("FILE")
  originalName         String
  /// Проверенный сервером тип, а не заявленный окном
  verifiedMime         String?
  declaredBytes        Int      @default(0)
  sha256               String
  chunkSize            Int      @default(0)
  chunkCount           Int      @default(0)
  /// OPEN | VERIFYING | READY | REJECTED | ATTACHED | EXPIRED
  status               String   @default("OPEN")
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
  revision             Int      @default(1)
  reportId             String?
  processingLeaseUntil DateTime?
  processingLeaseOwner String?

  chunks FeedbackUploadChunk[]

  @@unique([ownerId, clientRequestId])
  @@index([status, expiresAt])
  @@index([reportId])
}

/// Кусок загрузки. Повтор того же куска с тем же отпечатком — успех: обрыв
/// связи не должен требовать заново гнать весь файл.
model FeedbackUploadChunk {
  id         String   @id @default(uuid())
  uploadId   String
  upload     FeedbackUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  index      Int
  sha256     String
  bytes      Bytes
  byteLength Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([uploadId, index])
  @@index([uploadId])
}

/// Вложение, привязанное к карточке. Байты остаются в кусках загрузки —
/// здесь только описание, чтобы прикреплённое отличалось от черновой загрузки.
model FeedbackAttachment {
  id            String   @id @default(uuid())
  reportId      String
  uploadId      String   @unique
  /// IMAGE | FILE | DIAGNOSTICS
  kind          String   @default("FILE")
  displayName   String
  mime          String   @default("application/octet-stream")
  byteLength    Int      @default(0)
  sha256        String
  width         Int?
  height        Int?
  /// Миниатюра — производная того же вложения, а не отдельный файл человека
  thumbnailOfId String?
  createdAt     DateTime @default(now())
  expiresAt     DateTime?
  expiredAt     DateTime?

  @@index([reportId])
  @@index([thumbnailOfId])
}

/// Пакет диагностики, приложенный к обращению. Сырые события лежат вложением,
/// здесь — опись и сводка, посчитанная сервером: присланной клиентом не верим.
model FeedbackDiagnosticBundle {
  id           String   @id @default(uuid())
  reportId     String
  attachmentId String   @unique
  manifestJson String   @default("{}")
  summaryJson  String   @default("{}")
  /// Отпечаток технического дубля: предлагает совпадение, но не объединяет
  fingerprint  String?
  createdAt    DateTime @default(now())

  @@index([reportId])
}

/// Докуда человек дочитал. Внутренние ревизии не двигают счётчик автора.
model FeedbackReadState {
  id                  String   @id @default(uuid())
  reportId            String
  userId              String
  lastPublicRevision  Int      @default(0)
  lastInternalRevision Int     @default(0)
  updatedAt           DateTime @default(now()) @updatedAt

  @@unique([reportId, userId])
  @@index([userId])
}

/// Расписка о выполненном действии. Точный повтор возвращает прежний результат,
/// даже если карточка уже ушла вперёд: иначе двойное нажатие ломает историю.
model FeedbackMutationReceipt {
  id              String   @id @default(uuid())
  actorId         String
  clientRequestId String
  requestHash     String
  reportId        String
  resultRevision  Int      @default(0)
  resultJson      String   @default("{}")
  createdAt       DateTime @default(now())

  @@unique([actorId, clientRequestId])
  @@index([createdAt])
}

/// Очередь уведомлений. Запись кладётся в той же транзакции, что и событие,
/// которое она описывает, — иначе уведомление теряется между записью и
/// отправкой. Сокет только ускоряет доставку, но не заменяет эту очередь.
model FeedbackOutbox {
  id             String   @id @default(uuid())
  /// Ключ против повторов: тот же ключ второй записи не создаст
  dedupeKey      String   @unique
  reportId       String
  recipientId    String
  publicRevision Int      @default(0)
  kind           String
  payloadJson    String   @default("{}")
  /// PENDING | DONE | FAILED
  state          String   @default("PENDING")
  attempt        Int      @default(0)
  availableAt    DateTime @default(now())
  leaseUntil     DateTime?
  leaseOwner     String?
  createdAt      DateTime @default(now())

  @@index([state, availableAt])
  @@index([reportId])
}

/// Отметка об изменении карточки — для серверов, которые узнают о нём опросом,
/// а не сокетом. Текстов здесь нет намеренно.
model FeedbackChange {
  id         String   @id @default(uuid())
  reportId   String
  revision   Int
  visibility String   @default("PUBLIC")
  createdAt  DateTime @default(now())

  @@unique([reportId, revision])
  @@index([createdAt])
}
