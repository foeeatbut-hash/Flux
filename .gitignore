node_modules/
build/*
!build/icon.png
database/
dist-electron/
release/
*.sqlite-wal
*.sqlite-shm
prisma/**/*.sqlite
*.flux-owner
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

/src/generated/prisma
prisma-clients/**
!prisma-clients/client-sqlite/
!prisma-clients/client-sqlite/package.json
!prisma-clients/client-pg/
!prisma-clients/client-pg/package.json
!prisma-clients/client-mysql/
!prisma-clients/client-mysql/package.json

# Собранный exe уходит в GitHub Releases, а не в историю репозитория
portable/*.part
portable/*.exe
portable/СОБРАТЬ-EXE.bat

# Офлайн-генератор лицензий содержит приватный ключ — никогда не коммитить
license-generator.html
**/license-generator.html

# Закрытые ключи владельца (подпись выпусков, вход владельца) и подписи
# выпусков: ключ живёт только на машине владельца, подпись — рядом с exe
*.pem
*.key
update-key*
owner-key*
*.flux-sig

# Настоящие бланки поставщиков и черновые проверки по ним: в репозиторий не идут
# (в них имена сотрудников и данные заказчика). Обезличенные образцы той же
# формы лежат в scripts/fixtures/blanks.
.probe/
.walkthrough/

# Собранные редакторы Flux Office (tools/genoffice/build.mjs) и исходники GenOffice
public/genoffice/
genoffice-server/
.cache/

# Рабочие копии субагентов Claude Code (Agent с isolation: worktree) — иначе
# поиск в основном дереве видит каждый файл репозитория по нескольку раз.
.claude/worktrees/
