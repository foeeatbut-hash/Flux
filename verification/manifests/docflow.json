  "actions": [
    {
      "id": "docflow.open-legacy",
      "program": "docflow",
      "label": "Открыть ДО по старой ссылке ВДР",
      "sources": [
        "src/lib/docflowNavigation.ts",
        "src/screens/ProcurementManagement.tsx"
      ],
      "triggers": [
        "/management?tab=vdr",
        "/management?tab=docflow",
        "/management?vdr=…&item=…"
      ],
      "risk": "normal",
      "expected": [
        "Сохраняются реестр, строка и остальные параметры"
      ],
      "checks": [
        {
          "suite": "docflow-navigation",
          "layer": "unit",
          "claims": [
            "Старые параметры переводятся без потерь, обычные закупки не перенаправляются"
          ]
        }
      ],
      "manual": [
        {
          "layer": "browser-live",
          "scenario": "Открыть ссылку уведомления в оконной оболочке",
          "expected": [
            "Открыто ДО и выбрана нужная строка"
          ]
        }
      ]
    },
    {
      "id": "docflow.permissions-migrate",
      "program": "docflow",
      "label": "Перенести права ВДР в ДО",
      "sources": [
        "shared/docflowPermissions.ts",
        "server/docflowPermissionMigration.ts",
        "server/vdrPermissions.ts"
      ],
      "triggers": [
        "Запуск после обновления",
        "Обращение к API ВДР"
      ],
      "risk": "critical",
      "expected": [
        "Запреты и сроки сохранены",
        "docflow.files не выдаётся автоматически"
      ],
      "checks": [
        {
          "suite": "docflow-permissions",
          "layer": "api-db",
          "claims": [
            "Перенос в SQLite атомарен и повторяем без возврата снятых прав",
            "Перевод сохраняет запреты и сроки, новое право файлов закрыто"
          ]
        },
        {
          "suite": "docflow-vdr-permissions",
          "layer": "api-db",
          "claims": [
            "Маршруты защищены правами и доступом к проекту"
          ]
        }
      ],
      "manual": []
    },
    {
      "id": "docflow.mask-folder-check",
      "program": "docflow",
      "label": "Проверить маску по рабочей папке",
      "sources": [
        "src/components/docflow/MaskBuilder.tsx",
        "src/lib/docflowAssign.ts"
      ],
      "triggers": [
        "Проверить на файлах рабочей папки"
      ],
      "risk": "normal",
      "expected": [
        "Имена из рабочей папки и подпапок разбираются текущей маской без сохранения и изменения файлов",
        "Ошибка чтения видна и не выдаётся за успешный результат"
      ],
      "checks": [
        {
          "suite": "docflow-mask-ui",
          "layer": "component",
          "claims": [
            "Рабочая папка читается через мост, изменение маски и исключений сразу меняет разбор",
            "Проверка не пишет файлы и настройки, отказ чтения показывает ошибку"
          ]
        }
      ],
      "manual": [
        {
          "layer": "browser-live",
          "scenario": "Проверить маску в назначенной сетевой папке на Windows",
          "expected": [
            "Доступные файлы разобраны, ошибки доступа показаны"
          ]
        }
      ]
    }
  ],
  "connections": []
