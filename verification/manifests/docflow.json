  "actions": [
    {
      "id": "docflow.open-legacy",
      "program": "docflow",
      "label": "Открыть ДО по старой ссылке ВДР",
      "sources": [
        "src/lib/docflowNavigation.ts",
        "src/screens/ProcurementManagement.tsx"
      ],
      "triggers": [
        "/management?tab=vdr",
        "/management?tab=docflow",
        "/management?vdr=…&item=…"
      ],
      "risk": "normal",
      "expected": [
        "Сохраняются реестр, строка и остальные параметры"
      ],
      "checks": [
        {
          "suite": "docflow-navigation",
          "layer": "unit",
          "claims": [
            "Старые параметры переводятся без потерь, обычные закупки не перенаправляются"
          ]
        }
      ],
      "manual": [
        {
          "layer": "browser-live",
          "scenario": "Открыть ссылку уведомления в оконной оболочке",
          "expected": [
            "Открыто ДО и выбрана нужная строка"
          ]
        }
      ]
    },
    {
      "id": "docflow.permissions-migrate",
      "program": "docflow",
      "label": "Перенести права ВДР в ДО",
      "sources": [
        "shared/docflowPermissions.ts",
        "server/docflowPermissionMigration.ts",
        "server/vdrPermissions.ts"
      ],
      "triggers": [
        "Запуск после обновления",
        "Обращение к API ВДР"
      ],
      "risk": "critical",
      "expected": [
        "Запреты и сроки сохранены",
        "docflow.files не выдаётся автоматически"
      ],
      "checks": [
        {
          "suite": "docflow-permissions",
          "layer": "api-db",
          "claims": [
            "Перенос в SQLite атомарен и повторяем без возврата снятых прав",
            "Перевод сохраняет запреты и сроки, новое право файлов закрыто"
          ]
        },
        {
          "suite": "docflow-vdr-permissions",
          "layer": "api-db",
          "claims": [
            "Маршруты защищены правами и доступом к проекту"
          ]
        }
      ],
      "manual": []
    },
    {
      "id": "docflow.equipment-classes",
      "program": "docflow",
      "label": "Настроить классы оборудования проекта",
      "sources": [
        "shared/docflow/classMapping.ts",
        "shared/docflow/config.ts",
        "src/components/docflow/EquipmentClassesEditor.tsx"
      ],
      "triggers": [
        "Настройки → Классы оборудования"
      ],
      "risk": "normal",
      "expected": [
        "Соответствия типов и классов проекта проверяются и переносятся с настройками"
      ],
      "checks": [
        {
          "suite": "docflow-class-mapping",
          "layer": "unit",
          "claims": [
            "Нормализация, ошибки и перенос соответствий сохраняют различия по типам"
          ]
        },
        {
          "suite": "docflow-classes-ui",
          "layer": "component",
          "claims": [
            "Сохранение настроек и подтверждённый план назначают класс; отказ и отмена видны"
          ]
        },
        {
          "suite": "docflow-class-settings",
          "layer": "unit",
          "claims": [
            "Неизвестные классы и некорректные строки блокируют запись, перенос, шаблон и отмену"
          ]
        }
      ],
      "manual": []
    },
    {
      "id": "docflow.kit-settings",
      "program": "docflow",
      "label": "Настроить комплекты документов проекта",
      "sources": ["shared/docflow/kits.ts", "src/components/docflow/KitsEditor.tsx"],
      "triggers": ["Настройки → Комплекты"],
      "risk": "normal",
      "expected": ["Комплекты проверяются и переносятся с настройками проекта"],
      "checks": [
        { "suite": "docflow-kits", "layer": "unit", "claims": ["Старый формат читается, ошибки отклоняются, состав переносится с различиями"] },
        { "suite": "docflow-kits-ui", "layer": "component", "claims": ["Редактор блокирует некорректный черновик, сохраняет поля и отображает перенесённый комплект"] }
      ],
      "manual": []
    },
    {
      "id": "docflow.mask-folder-check",
      "program": "docflow",
      "label": "Проверить маску по рабочей папке",
      "sources": [
        "src/components/docflow/MaskBuilder.tsx",
        "src/lib/docflowAssign.ts"
      ],
      "triggers": [
        "Проверить на файлах рабочей папки"
      ],
      "risk": "normal",
      "expected": [
        "Имена из рабочей папки и подпапок разбираются текущей маской без сохранения и изменения файлов",
        "Ошибка чтения видна и не выдаётся за успешный результат"
      ],
      "checks": [
        {
          "suite": "docflow-mask-ui",
          "layer": "component",
          "claims": [
            "Рабочая папка читается через мост, изменение маски и исключений сразу меняет разбор",
            "Проверка не пишет файлы и настройки, отказ чтения показывает ошибку"
          ]
        }
      ],
      "manual": [
        {
          "layer": "browser-live",
          "scenario": "Проверить маску в назначенной сетевой папке на Windows",
          "expected": [
            "Доступные файлы разобраны, ошибки доступа показаны"
          ]
        }
      ]
    },
    {
      "id": "docflow.equipment-class-plan",
      "program": "docflow",
      "label": "Заполнить классы оборудования проекта",
      "sources": [
        "server/equipmentClasses.ts",
        "server/routes/equipmentClasses.ts",
        "server/docflowPlans.ts"
      ],
      "triggers": [
        "POST /api/equipment/projects/:projectId/catalog-classes/plan",
        "POST /api/equipment/projects/:projectId/catalog-classes/apply",
        "POST /api/equipment/projects/:projectId/catalog-classes/undo",
        "GET /api/equipment/projects/:projectId/catalog-classes/last"
      ],
      "risk": "critical",
      "expected": [
        "Классы назначаются только подтверждённым тегам доступного проекта; общие записи и чужие теги сохраняются",
        "Устаревший план и отмена после новой правки не перезаписывают данные"
      ],
      "checks": [
        {
          "suite": "docflow-equipment-classes",
          "layer": "api-db",
          "claims": [
            "HTTP проверяет право и доступ к проекту, неизвестные ссылки отклоняются",
            "Предпросмотр, применение, повтор, отмена и сроки проверяются на SQLite"
          ]
        },
        {
          "suite": "docflow-stage2-security-db",
          "layer": "api-db",
          "claims": [
            "Схема и проектный план с проверкой прав, устаревшего состояния и отмены проверяются на SQLite, MariaDB и PostgreSQL"
          ]
        }
      ],
      "manual": []
    } ,
    {
      "id": "docflow.kit-rows",
      "program": "docflow",
      "label": "Заполнить недостающие строки комплектов",
      "sources": ["server/docflowKitRows.ts", "server/docflowKitContext.ts", "server/docflowKitRefs.ts", "server/routes/docflowKits.ts"],
      "triggers": ["GET /api/docflow/tags", "POST /api/docflow/kits/plan", "POST /api/docflow/kits/apply", "POST /api/docflow/kits/undo"],
      "risk": "critical",
      "expected": ["Строки создаются только по подтверждённому плану с правами проекта", "Повтор, конкурирующий план и отмена сохраняют чужие изменения и не создают дубликаты"],
      "checks": [
        { "suite": "docflow-kit-rows", "layer": "api-db", "claims": ["Права, предпросмотр, применение, повтор, конкуренция и безопасная отмена проверяются через HTTP и SQLite", "Стадии, общие документы, условия, сроки, ссылки и ограничения уникальности проверяются на fixture"] },
        { "suite": "docflow-kit-tags-ui", "layer": "component", "claims": ["План не создаёт строки до подтверждения, повтор не предлагает дубликат, отмена и переход к связанной строке доступны"] }
      ],
      "manual": []
    }
  ],
  "connections": []
}
