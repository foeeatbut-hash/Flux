      "triggers": [
        "POST /api/equipment/projects/:projectId/catalog-classes/plan",
        "POST /api/equipment/projects/:projectId/catalog-classes/apply",
        "POST /api/equipment/projects/:projectId/catalog-classes/undo",
        "GET /api/equipment/projects/:projectId/catalog-classes/last"
      ],
      "risk": "critical",
      "expected": [
        "Классы назначаются только подтверждённым тегам доступного проекта; общие записи и чужие теги сохраняются",
