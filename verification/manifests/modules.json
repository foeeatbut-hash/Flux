  "actions": [
    {
      "id": "modules.open",
      "program": "modules",
      "label": "Открыть модуль",
      "risk": "normal",
      "sources": [
        "src/screens/ModuleHost.tsx",
        "src/components/modules/ModuleFrame.tsx",
        "src/components/modules/ModuleLaunchActions.tsx"
      ],
      "triggers": [
        "menu",
        "button"
      ],
      "expected": [
        "Модуль открывается в окне с контекстом выбранной позиции или тега"
      ],
      "checks": [
        {
          "suite": "modules-contract",
          "layer": "unit",
          "claims": [
            "Готовый модуль получает контекст открытия"
          ]
        },
        {
          "suite": "modules-native",
          "layer": "windows-native",
          "claims": [
            "В Electron модуль отображает позицию и тег; вход из тега разрешает связанную позицию",
            "Геометрия проверяется в двух темах и двух размерах окна"
          ]
        },
        {
          "suite": "modules-flux-ui-live",
          "layer": "windows-native",
          "claims": [
            "Полный Flux: вход, Пуск и карточки позиции и тега открывают настоящий модуль; замеры и снимки обеих тем"
          ]
        },
        {
          "suite": "modules-form",
          "layer": "unit",
          "claims": [
            "Сборка отклоняет неизвестный ресурс, поле и колонку формы по договору"
          ]
        }
      ],
      "manual": [
        {
          "layer": "portable",
          "scenario": "Открыть модуль из меню и карточек в portable на рабочем месте компании",
          "expected": [
            "Окно показывает выбранные данные в обеих темах"
          ]
        }
      ]
    },
    {
      "id": "modules.read",
      "program": "modules",
      "label": "Читать данные Flux",
      "risk": "critical",
      "sources": [
        "modules/bridge.ts",
        "modules/schemas.ts",
        "modules/protocol.ts",
        "src/services/moduleDataService.ts"
      ],
      "triggers": [
        "background"
      ],
      "expected": [
        "Модуль читает только разрешённые данные и не может записывать их или обращаться к закрытым ресурсам"
      ],
      "checks": [
        {
          "suite": "modules-limits",
          "layer": "unit",
          "claims": [
            "Мост ограничивает частоту и размер сообщений и отклоняет попытки записи"
          ]
        },
        {
          "suite": "modules-data",
          "layer": "unit",
          "claims": [
            "Проекции сохраняют ручные параметры, состав и единицы; служебные данные не выдаются",
            "Закрытый проект и 403 не подменяются локальными данными"
          ]
        },
        {
          "suite": "modules-contract",
          "layer": "unit",
          "claims": [
            "Схемы ресурсов отклоняют неизвестные поля и неверную форму",
            "Мост отвергает чужие сообщения и запись, проверяет разрешения и исходящие данные",
            "Протокол отвергает неподходящие пути"
          ]
        },
        {
          "suite": "modules-native",
          "layer": "windows-native",
          "claims": [
            "В Electron закрыты cookie, localStorage, IPC, Node и сеть; запись отклоняется без изменения временной базы",
            "Сообщение вне схемы отбрасывается"
          ]
        }
      ],
      "manual": [
        {
          "layer": "portable",
          "scenario": "Открыть позицию в portable на рабочем месте компании",
          "expected": [
            "Модуль показывает доступные позиции параметры"
          ]
        }
      ]
    },
    {
      "id": "modules.refresh",
      "program": "modules",
      "label": "Обновить данные модуля",
      "risk": "normal",
      "sources": [
        "src/components/modules/ModuleFrame.tsx",
        "modules/bridge.ts",
        "modules/runtime/frame.ts",
        "src/services/moduleDataService.ts"
      ],
      "triggers": [
        "background"
      ],
      "expected": [
        "Открытый модуль получает изменения позиции и не показывает данные прежнего проекта"
      ],
      "checks": [
        {
          "suite": "modules-contract",
          "layer": "unit",
          "claims": [
            "Событие изменения доставляется, а ответ прежнего проекта и ответы после закрытия отбрасываются"
          ]
        },
        {
          "suite": "modules-native",
          "layer": "windows-native",
          "claims": [
            "Изменение позиции через маршрут и entity:changed доходит до модуля; смена проекта удаляет прежние данные"
          ]
        },
        {
          "suite": "modules-refresh",
          "layer": "unit",
          "claims": [
            "Окна разделяют GET, событие сбрасывает общий кэш, редкий запасной опрос работает только без сокета"
          ]
        }
      ],
      "manual": [
        {
          "layer": "portable",
          "scenario": "Изменить позицию при открытом модуле в portable на рабочем месте компании",
          "expected": [
            "Изменение появляется в модуле"
          ]
        }
      ]
    },
    {
