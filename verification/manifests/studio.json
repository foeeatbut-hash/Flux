{
  "version": 1,
  "group": "studio",
  "programs": [
    {
      "id": "studio",
      "label": "Flux Studio",
      "routes": [],
      "sources": [
        "studio/entry-developer.ts",
        "studio/shell/main.ts",
        "studio/shell/api.ts",
        "studio/shell/preload.ts",
        "studio/renderer/main.tsx",
        "server/routes/studio.ts",
        "studio/renderer/styles.css",
        "studio/renderer/index.html",
        "studio/entry-owner.ts",
        "studio/build.cjs",
        "scripts/check-studio-bundle.ts",
        "studio/renderer/editors/CodeEditor.tsx",
        "studio/renderer/editors/CodeView.tsx",
        "studio/renderer/editors/ContractEditor.tsx",
        "studio/renderer/editors/FormEditor.tsx",
        "studio/renderer/editors/FormPalette.tsx",
        "studio/renderer/editors/FormPreview.tsx",
        "studio/renderer/editors/FormProps.tsx",
        "studio/renderer/editors/FormTextEditor.tsx",
        "studio/renderer/editors/FormTree.tsx",
        "studio/renderer/editors/RulesPanel.tsx",
        "studio/renderer/editors/codeSupport.ts",
        "studio/renderer/editors/contractModel.ts",
        "studio/renderer/editors/contractTypes.ts",
        "studio/renderer/editors/controls.tsx",
        "studio/renderer/editors/designCheck.ts",
        "studio/renderer/editors/formModel.ts",
        "studio/renderer/editors/formSchema.ts",
        "studio/renderer/editors/formStore.ts",
        "studio/renderer/editors/harness/main.tsx",
        "studio/renderer/editors/index.tsx",
        "studio/renderer/editors/jsonText.ts",
        "studio/renderer/editors/methodology.generated.ts",
        "studio/renderer/editors/methodology.ts",
        "studio/renderer/editors/methodologyTypes.ts",
        "studio/renderer/editors/miniSchema.ts",
        "studio/renderer/editors/paths.ts",
        "studio/renderer/editors/previewModel.ts",
        "studio/renderer/editors/sample.ts",
        "studio/renderer/editors/styles.ts",
        "studio/renderer/editors/types.ts",
        "scripts/gen-studio-editor-methodology.ts",
        "modules/dataSchemas.ts"
      ]
    }
  ],
  "suites": [
    {
      "id": "studio-access",
      "path": "scripts/test-studio-access.ts",
      "layer": "api-db",
      "platform": "any",
      "resources": [
        "synthetic-temp-files",
        "loopback-http"
      ],
      "prerequisites": [],
      "timeoutMs": 300000
    },
    {
      "id": "studio-shell",
      "path": "scripts/test-studio-shell.ts",
      "layer": "unit",
      "platform": "any",
      "resources": [
        "synthetic-temp-files",
        "loopback-http"
      ],
      "prerequisites": [],
      "timeoutMs": 300000
    },
    {
      "id": "studio-bundle",
      "path": "scripts/test-studio-bundle.ts",
      "layer": "unit",
      "platform": "any",
      "resources": [
        "synthetic-temp-files"
      ],
      "prerequisites": [],
      "timeoutMs": 300000
    },
    {
      "id": "studio-owner-section",
      "path": "scripts/test-studio-owner-section.ts",
      "layer": "unit",
      "platform": "any",
      "resources": [
        "synthetic-temp-files"
      ],
      "prerequisites": [],
      "timeoutMs": 300000
    },
    {
      "id": "studio-ui",
      "path": "scripts/test-studio-ui.ts",
      "layer": "browser-live",
      "platform": "any",
      "resources": [
        "synthetic-temp-files"
      ],
      "prerequisites": [
        {
          "kind": "env",
          "name": "FLUX_CHROME"
        }
      ],
      "timeoutMs": 300000
    },
    {
      "id": "studio-editor",
      "path": "scripts/test-studio-editor.ts",
      "layer": "unit",
      "platform": "any",
      "resources": [
        "synthetic-temp-files"
      ],
      "prerequisites": [],
      "timeoutMs": 300000
    },
    {
      "id": "studio-editor-ui",
      "path": "scripts/test-studio-editor-ui.ts",
      "layer": "browser-live",
      "platform": "any",
      "resources": [
        "synthetic-temp-files"
      ],
      "prerequisites": [
        {
          "kind": "env",
          "name": "FLUX_CHROME"
        }
      ],
      "timeoutMs": 300000
    },
    {
      "id": "studio-owner-diagnostics",
      "path": "studio/owner/scripts/test-diagnostics.cjs",
      "layer": "unit",
      "platform": "any",
      "resources": [
        "synthetic-temp-files"
      ],
      "prerequisites": [],
      "timeoutMs": 300000
    },
    {
      "id": "studio-owner-network",
      "path": "studio/owner/scripts/test-network.cjs",
      "layer": "unit",
      "platform": "any",
      "resources": [
        "loopback-http"
      ],
      "prerequisites": [],
      "timeoutMs": 300000
    }
  ],
  "actions": [
    {
      "id": "studio.sign-in",
      "program": "studio",
      "label": "Вход разработчика в Studio",
      "sources": [
        "studio/shell/main.ts",
        "studio/shell/api.ts",
        "server/routes/studio.ts"
      ],
      "triggers": [
        "кнопка «Войти»"
      ],
      "risk": "critical",
      "expected": [
        "Пускает право «Разработка подпрограмм»; без права отказывает сервер, окно сессии не получает"
      ],
      "checks": [
        {
          "suite": "studio-access",
          "layer": "api-db",
          "claims": [
            "Сервер отвечает 403 без права (и администратору без права), 200 с module.develop и владельцу",
            "Свои подпрограммы видны только автору, список ограничен"
          ]
        },
        {
          "suite": "studio-shell",
          "layer": "unit",
          "claims": [
            "Вход, отказ без права и неверный пароль через настоящие маршруты; токен остаётся в главном процессе; чужое окно и неизвестное действие отклоняются"
          ]
        }
      ],
      "manual": [
        {
          "layer": "portable",
          "scenario": "Войти в FluxStudio.exe разработчиком с правом и сотрудником без права на общей базе компании",
          "expected": [
            "Разработчик входит, сотрудник видит отказ с подсказкой"
          ]
        }
      ]
    },
    {
      "id": "studio.connect",
      "program": "studio",
      "label": "Подключение к общей базе",
      "sources": [
        "studio/shell/main.ts",
        "studio/renderer/main.tsx"
      ],
      "triggers": [
        "кнопка «Подключиться»"
      ],
      "risk": "critical",
      "expected": [
        "Адрес базы не сохраняется и не показывается; обработчик останавливается при отключении"
      ],
      "checks": [
        {
          "suite": "studio-shell",
          "layer": "unit",
          "claims": [
            "Адрес нигде не сохранён, отключение останавливает обработчик, в окно уходит только перечисленное состояние"
          ]
        },
        {
          "suite": "studio-ui",
          "layer": "browser-live",
          "claims": [
            "Поле адреса скрыто как пароль в обеих темах"
          ]
        }
      ],
      "manual": [
        {
          "layer": "portable",
          "scenario": "Подключиться к настоящей MariaDB рядом с Flux того же выпуска",
          "expected": [
            "Подключение подтверждается, без Flux рядом — понятное сообщение"
          ]
        }
      ]
    },
    {
      "id": "studio.modules-list",
      "program": "studio",
      "label": "Раздел «Подпрограммы»",
      "sources": [
        "studio/renderer/main.tsx",
        "server/routes/studio.ts"
      ],
      "triggers": [
        "вход",
        "раздел «Подпрограммы»"
      ],
      "risk": "normal",
      "expected": [
        "Видны свои подпрограммы и состояние последней отправки; пустой список объяснён"
      ],
      "checks": [
        {
          "suite": "studio-access",
          "layer": "api-db",
          "claims": [
            "Только свои, не больше предела"
          ]
        },
        {
          "suite": "studio-ui",
          "layer": "browser-live",
          "claims": [
            "Список и пустое состояние в обеих темах, замеры без переполнения, контраст, снимки"
          ]
        }
      ],
      "manual": []
    },
    {
      "id": "studio.two-builds",
      "program": "studio",
      "label": "Две сборки: разработчик и владелец",
      "sources": [
        "studio/build.cjs",
        "studio/entry-developer.ts",
        "studio/entry-owner.ts",
        "scripts/check-studio-bundle.ts"
      ],
      "triggers": [
        "сборка в CI"
      ],
      "risk": "critical",
      "expected": [
        "В сборке разработчика кода владельца нет; обе сборки с одним номером версии Flux"
      ],
      "checks": [
        {
          "suite": "studio-bundle",
          "layer": "unit",
          "claims": [
            "Проверка бандла проходит у разработчика, падает у владельца и на мутациях (модуль владельца в сборке разработчика, метка в пакете и в asar)",
            "Версия обеих сборок совпадает с Flux, имена exe по решению владельца"
          ]
        }
      ],
      "manual": [
        {
          "layer": "portable",
          "scenario": "Собрать обе программы в CI (windows-latest) и проверить app.asar разработчика",
          "expected": [
            "Проверка зелёная, файлы FluxStudio.exe и FluxStudio-Владелец.exe"
          ]
        }
      ]
    },
    {
      "id": "studio.owner-section",
      "program": "studio",
      "label": "Раздел владельца в Studio — Владелец",
      "sources": [
        "studio/entry-owner.ts",
        "studio/shell/main.ts",
        "studio/build.cjs"
      ],
      "triggers": [
        "меню «Лицензии и обновления Flux»"
      ],
      "risk": "critical",
      "expected": [
        "Открывается окно прежнего Flux Owner; хранилище ключей прежнее по пути и формату, перевыпуск лицензий не нужен"
      ],
      "checks": [
        {
          "suite": "studio-owner-section",
          "layer": "unit",
          "claims": [
            "Готовый пакет владельца открывает хранилище прежнего Flux Owner теми же открытыми ключами, создаёт новое тем же форматом; у разработчика раздела и канала нет"
          ]
        },
        {
          "suite": "studio-ui",
          "layer": "browser-live",
          "claims": [
            "Раздел в меню только в сборке владельца"
          ]
        }
      ],
      "manual": [
        {
          "layer": "portable",
          "scenario": "Открыть FluxStudio-Владелец.exe с настоящим хранилищем владельца на компьютере владельца, подключиться, выпустить тестовую лицензию и обновление",
          "expected": [
            "Хранилище открывается прежним паролем, лицензия и обновление принимаются Flux"
          ]
        }
      ]
    },
    {
      "id": "studio.owner-diagnostics",
      "program": "studio",
      "label": "Диагностика и сетевые пределы раздела владельца",
      "sources": [
        "studio/owner/src/diagnostics.cjs",
        "studio/owner/src/network.cjs"
      ],
      "triggers": [
        "журнал",
        "запрос к локальному серверу"
      ],
      "risk": "normal",
      "expected": [
        "Журнал скрывает секреты, запросы только к loopback и по списку маршрутов владельца"
      ],
      "checks": [
        {
          "suite": "studio-owner-diagnostics",
          "layer": "unit",
          "claims": [
            "Скрытие данных, связь операций, ротация и экспорт"
          ]
        },
        {
          "suite": "studio-owner-network",
          "layer": "unit",
          "claims": [
            "Таймауты, отмена, проверка ответов, только локальный адрес"
          ]
        }
      ],
      "manual": []
    }
  ],
  "connections": [
    {
      "id": "studio.to-flux-server",
      "from": "studio",
      "to": "users",
      "status": "implemented",
      "sources": [
        "server/routes/studio.ts",
        "studio/shell/api.ts"
      ],
      "expected": [
        "Studio входит по тем же профилям и правам, что и Flux; право проверяет сервер"
      ],
      "checks": [
        {
          "suite": "studio-access",
          "layer": "api-db",
          "claims": [
            "Право module.develop и владелец пускают, остальные получают 403"
          ]
        }
      ],
      "manual": []
    }
  ]
}
