  "actions": [
    {
      "id": "studio.sign-in",
      "program": "studio",
      "label": "Вход разработчика в Studio",
      "sources": [
        "studio/shell/main.ts",
        "studio/shell/api.ts",
        "server/routes/studio.ts"
      ],
      "triggers": [
        "кнопка «Войти»"
      ],
      "risk": "critical",
      "expected": [
        "Пускает право «Разработка подпрограмм»; без права отказывает сервер, окно сессии не получает"
      ],
      "checks": [
        {
          "suite": "studio-access",
          "layer": "api-db",
          "claims": [
            "Сервер отвечает 403 без права (и администратору без права), 200 с module.develop и владельцу",
            "Свои подпрограммы видны только автору, список ограничен"
          ]
        },
        {
          "suite": "studio-shell",
          "layer": "unit",
          "claims": [
            "Вход, отказ без права и неверный пароль через настоящие маршруты; токен остаётся в главном процессе; чужое окно и неизвестное действие отклоняются"
          ]
        },
        {
          "suite": "studio-shell",
          "layer": "unit",
          "claims": [
            "Вход владельца файлом ключа: выбор файла, неверный пароль, синтетический ключ, токен окну не уходит, разделы владельца видны только владельцу",
            "Подключение не отменяет само себя: сброс прежнего подключения не прерывает текущее"
          ]
        },
        {
          "suite": "unified-login-ui",
          "layer": "browser-live",
          "claims": [
            "Экран входа Studio совпадает с экраном Flux до пикселя в обеих темах: карточка, поля, кнопка, фон"
          ]
        },
        {
          "suite": "studio-ui",
          "layer": "browser-live",
          "claims": [
            "Порядок шагов: подключение к базе, логин и пароль, «Вход владельца»; обе темы, снимки"
          ]
        }
      ],
      "manual": [
        {
          "layer": "portable",
          "scenario": "Войти в FluxStudio.exe разработчиком с правом и сотрудником без права на общей базе компании",
          "expected": [
            "Разработчик входит, сотрудник видит отказ с подсказкой"
          ]
        }
      ]
    },
    {
      "id": "studio.connect",
      "program": "studio",
      "label": "Подключение к общей базе",
      "sources": [
        "studio/shell/main.ts",
        "studio/renderer/main.tsx"
      ],
      "triggers": [
        "кнопка «Подключиться»"
      ],
      "risk": "critical",
      "expected": [
        "Адрес базы не сохраняется и не показывается; обработчик останавливается при отключении"
      ],
      "checks": [
        {
          "suite": "studio-shell",
          "layer": "unit",
          "claims": [
            "Адрес нигде не сохранён, отключение останавливает обработчик, в окно уходит только перечисленное состояние"
          ]
        },
        {
          "suite": "studio-ui",
          "layer": "browser-live",
          "claims": [
            "Поле адреса скрыто как пароль в обеих темах"
          ]
        },
        {
          "suite": "studio-electron-start",
          "layer": "browser-live",
          "claims": [
            "Настоящий запуск собранной Studio под Electron доходит до экрана входа: заставка погашена, рамка окна на месте"
          ]
        }
      ],
      "manual": [
        {
          "layer": "portable",
          "scenario": "Подключиться к настоящей MariaDB рядом с Flux того же выпуска",
          "expected": [
            "Подключение подтверждается, без Flux рядом — понятное сообщение"
          ]
        }
      ]
    },
    {
      "id": "studio.modules-list",
      "program": "studio",
      "label": "Раздел «Подпрограммы»",
      "sources": [
        "studio/renderer/main.tsx",
        "server/routes/studio.ts"
      ],
      "triggers": [
        "вход",
        "раздел «Подпрограммы»"
      ],
      "risk": "normal",
      "expected": [
        "Видны свои подпрограммы и состояние последней отправки; пустой список объяснён"
      ],
      "checks": [
        {
          "suite": "studio-access",
          "layer": "api-db",
          "claims": [
            "Только свои, не больше предела"
          ]
        },
        {
          "suite": "studio-ui",
          "layer": "browser-live",
          "claims": [
            "Список и пустое состояние в обеих темах, замеры без переполнения, контраст, снимки"
          ]
        }
      ],
      "manual": []
    },
    {
      "id": "studio.two-builds",
      "program": "studio",
      "label": "Две сборки: разработчик и владелец",
      "sources": [
        "studio/build.cjs",
        "studio/entry-developer.ts",
        "studio/entry-owner.ts",
        "scripts/check-studio-bundle.ts"
      ],
      "triggers": [
        "сборка в CI"
      ],
      "risk": "critical",
      "expected": [
        "В сборке разработчика кода владельца нет; обе сборки с одним номером версии Flux"
      ],
      "checks": [
        {
          "suite": "studio-bundle",
          "layer": "unit",
          "claims": [
            "Проверка бандла проходит у разработчика, падает у владельца и на мутациях (модуль владельца в сборке разработчика, метка в пакете и в asar)",
            "Версия обеих сборок совпадает с Flux, имена exe по решению владельца"
          ]
        },
        {
          "suite": "studio-icons",
          "layer": "unit",
          "claims": [
            "У Flux, Studio и Studio — Владелец разные значки: хеши, размеры 16–256, подключение в electron-builder, значок окна = значок exe"
          ]
        },
        {
          "suite": "studio-bundle",
          "layer": "unit",
          "claims": [
            "Вход владельца файлом ключа есть в обеих сборках, а подпись выпусков, лицензий и запись хранилища у разработчика по-прежнему запрещены"
          ]
        }
      ],
      "manual": [
        {
          "layer": "portable",
          "scenario": "Собрать обе программы в CI (windows-latest) и проверить app.asar разработчика",
          "expected": [
            "Проверка зелёная, файлы FluxStudio.exe и FluxStudio-Владелец.exe"
          ]
        }
      ]
    },
    {
      "id": "studio.owner-section",
      "program": "studio",
      "label": "Раздел владельца в Studio — Владелец",
      "sources": [
        "studio/entry-owner.ts",
        "studio/shell/main.ts",
        "studio/build.cjs"
      ],
      "triggers": [
        "меню «Лицензии и обновления Flux»"
      ],
      "risk": "critical",
      "expected": [
        "Открывается окно прежнего Flux Owner; хранилище ключей прежнее по пути и формату, перевыпуск лицензий не нужен"
      ],
      "checks": [
        {
          "suite": "studio-owner-section",
          "layer": "unit",
          "claims": [
            "Готовый пакет владельца открывает хранилище прежнего Flux Owner теми же открытыми ключами, создаёт новое тем же форматом; у разработчика раздела и канала нет"
          ]
        },
        {
          "suite": "studio-ui",
          "layer": "browser-live",
          "claims": [
            "Раздел в меню только в сборке владельца"
          ]
        }
      ],
      "manual": [
        {
          "layer": "portable",
          "scenario": "Открыть FluxStudio-Владелец.exe с настоящим хранилищем владельца на компьютере владельца, подключиться, выпустить тестовую лицензию и обновление",
          "expected": [
            "Хранилище открывается прежним паролем, лицензия и обновление принимаются Flux"
          ]
        }
      ]
    },
